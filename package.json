{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "planeward",
  "version": "0.1.2",
  "description": "Local CLI for building Planeward community apps: `planeward dev` runs an emulator of the Planeward host, API and webhooks.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/planeward/cli#readme",
  "bugs": {
    "url": "https://github.com/planeward/cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/planeward/cli.git"
  },
  "keywords": [
    "planeward",
    "cli",
    "emulator",
    "community",
    "apps",
    "webhooks",
    "sdk"
  ],
  "bin": {
    "planeward": "./dist/bin.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "exports": {
    "./schema/planeward.schema.json": "./schema/planeward.schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && pnpm build:ui",
    "build:ui": "vite build --config src/emulator/ui/vite.config.ts",
    "dev:ui": "vite --config src/emulator/ui/vite.config.ts",
    "update-openapi": "node scripts/update-openapi.mjs",
    "prepublishOnly": "pnpm build",
    "release": "bumpp --commit \"chore(release): v%s\" --no-push",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/emulator/ui",
    "lint": "eslint .",
    "test": "tsx --test --test-timeout=30000 'src/**/*.test.ts'",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@planeward/sdk": "^0.2.2",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "open": "^11.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lucide-react": "^1.68.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0"
}
